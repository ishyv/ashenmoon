{
  "name": "ashenmoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A dark-fantasy survival sandbox RPG built with SvelteKit and Pixi.js.",
  "author": "Hyvnt",
  "license": "MIT",
  "homepage": "https://github.com/ishyv/ashenmoon#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishyv/ashenmoon.git"
  },
  "bugs": {
    "url": "https://github.com/ishyv/ashenmoon/issues"
  },
  "keywords": [
    "game",
    "rpg",
    "survival",
    "sandbox",
    "sveltekit",
    "svelte",
    "pixi",
    "pixijs"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "bun run check && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "validate:visuals": "vitest run --reporter=verbose src/lib/core/systems/visual/visual-coverage.test.ts"
  },
  "dependencies": {
    "@hyvnt/hyvui": "^0.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.0",
    "dotenv": "^17.4.2",
    "lucide-svelte": "^0.468.0",
    "miniplex": "^2.0.0",
    "mongodb": "^6.21.0",
    "pixi.js": "^8.19.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/kit": "^2.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "jsdom": "^25.0.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
