    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.0",
    "dotenv": "^17.4.2",
    "lucide-svelte": "^0.468.0",
    "miniplex": "^2.0.0",
    "monaco-editor": "^0.55.1",
    "mongodb": "^6.21.0",
    "pixi.js": "^8.19.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.64.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "jsdom": "^25.0.1",
    "svelte": "^5.56.3",
