{
  "name": "tx-moderation-webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted SvelteKit moderation dashboard for the tx Discord bot. Runs in-process alongside the bot and uses a typed bridge for live data.",
  "author": "Hyvnt",
  "license": "MIT",
  "homepage": "https://github.com/ishyv/tx-discord-bot-webapp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ishyv/tx-discord-bot-webapp.git"
  },
  "bugs": {
    "url": "https://github.com/ishyv/tx-discord-bot-webapp/issues"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "dashboard",
    "moderation",
    "sveltekit",
    "svelte",
    "self-hosted"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hyvnt/hyvui": "^0.4.0",
