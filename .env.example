# ashenmoon environment
#
# Placeholder values only. Keep real credentials in your local environment or a
# local dotenv file; do not commit secrets.

# MongoDB connection used for player save data and progression.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=ashenmoon

# Optional: user id permitted to edit RPG content in production builds.
# Outside production (NODE_ENV !== "production"), content editing is open for
# local development, so this can be left unset.
ADMIN_USER_ID=
